#!/usr/bin/env bash
# aeo-platform pre-push hook — runs FULL tier before push.
# NO bypass — founder decision 2026-06-06: «Мы никогда не должны скипать тесты».

remote="$1"
url="$2"

# Read stdin to detect what's being pushed. Skip ONLY when the push contains
# nothing but tags — a mixed branch+tag push (--follow-tags) MUST still run tests.
has_branch_ref=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_ref" != refs/tags/* ]]; then
    has_branch_ref=1
  fi
done
if [ "$has_branch_ref" -eq 0 ]; then
  echo "[pre-push] tag-only push — skipping test run"
  exit 0
fi

echo "[pre-push] running npm test (full tier)..."
EXIT=0
npm test || EXIT=$?

if [ $EXIT -ne 0 ]; then
  echo ""
  echo "[pre-push] BLOCKED — tests failed. Fix before push (no skip — tests always run)."
  exit 1
fi

# Determinism check — re-run if main branch
current_branch=$(git rev-parse --abbrev-ref HEAD)
if [[ "$current_branch" == "main" || "$current_branch" == "master" ]]; then
  echo "[pre-push] running deterministic check (2nd run for main/master)..."
  EXIT2=0
  npm test || EXIT2=$?
  if [ $EXIT2 -ne 0 ]; then
    echo "[pre-push] BLOCKED — flake detected (pass on run 1, fail on run 2). Investigate before push to main."
    exit 1
  fi
fi

echo "[pre-push] all tests passed (deterministic)"
exit 0
