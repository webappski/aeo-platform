#!/usr/bin/env bash
# aeo-platform pre-commit hook — runs FAST tier tests before commit.
# Installed via core.hooksPath = .githooks (set by npm postinstall).
# NO bypass — founder decision 2026-06-06: «Мы никогда не должны скипать тесты».

# Fast tier: only run unit tests (not full E2E suite)
# E2E goes through pre-push or CI
echo "[pre-commit] running npm test (fast tier)..."
EXIT=0
npm test || EXIT=$?

if [ $EXIT -ne 0 ]; then
  echo ""
  echo "[pre-commit] BLOCKED — tests failed. Fix before commit (no skip — tests always run)."
  exit 1
fi

echo "[pre-commit] all tests passed"
exit 0
