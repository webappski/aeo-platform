#!/usr/bin/env bash
# aeo-platform pre-commit hook — runs the FULL test matrix before every commit.
# Installed via core.hooksPath = .githooks (set by npm postinstall).
# NO bypass — founder decision 2026-06-06: «Мы никогда не должны скипать тесты».
#
# It runs `npm test`, which is the whole `&&` chain INCLUDING `test:e2e` — so a
# commit here costs minutes, and that is deliberate: this hook and
# `prepublishOnly` are the ONLY gates. There is no CI workflow in this repo and
# no pre-push hook, so nothing runs these tests later if this does not run them
# now. The comments here said "fast tier: only unit tests" and "E2E goes through
# pre-push or CI" until 2026-09-21; neither was ever true, and an agent reading
# them would have budgeted seconds for a minutes-long commit and believed in a
# safety net that does not exist.
echo "[pre-commit] running the full npm test matrix (includes E2E — this takes minutes)..."
EXIT=0
npm test || EXIT=$?

if [ $EXIT -ne 0 ]; then
  echo ""
  echo "[pre-commit] BLOCKED — tests failed. Fix before commit (no skip — tests always run)."
  exit 1
fi

echo "[pre-commit] all tests passed"
exit 0
